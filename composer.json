{
    "name": "jolanuk/filament-gutenberg",
    "description": "Implementation of the Gutenberg standalone editor into Filament.",
    "keywords": [
        "JolanUK",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-gutenberg"
    ],
    "homepage": "https://github.com/jolanuk/filament-gutenberg",
    "support": {
        "issues": "https://github.com/jolanuk/filament-gutenberg/issues",
        "source": "https://github.com/jolanuk/filament-gutenberg"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Kris Young",
            "email": "development@jolan.uk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "JolanUK\\FilamentGutenberg\\": "src/",
            "JolanUK\\FilamentGutenberg\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JolanUK\\FilamentGutenberg\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JolanUK\\FilamentGutenberg\\FilamentGutenbergServiceProvider"
            ],
            "aliases": {
                "FilamentGutenberg": "JolanUK\\FilamentGutenberg\\Facades\\FilamentGutenberg"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}